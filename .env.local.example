# ===========================================
# Group Nom Environment Variables
# ===========================================
# Copy this to .env.local and fill in your values.
# In Vercel, `vercel env pull .env.local` fetches everything except the
# Upstash vars, which are marked Sensitive (copy those from the Upstash console).

# ===========================================
# Clerk Authentication (REQUIRED)
# ===========================================
# https://dashboard.clerk.com — use pk_test/sk_test locally; live keys are
# domain-locked to groupnom.com and will not work on localhost.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Clerk redirect URLs (optional - defaults work for most cases)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhook → /api/webhooks/clerk (keeps profiles in sync, anonymizes on delete)
# Dashboard → Webhooks → Add endpoint → subscribe to user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxx

# ===========================================
# Neon Postgres (REQUIRED) — restaurants, nominations, profiles, follows
# ===========================================
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ===========================================
# Upstash Redis via Vercel marketplace (REQUIRED) — sessions, rate limits, Today's Five cache
# ===========================================
# The marketplace integration prefixes these with db1_. lib/kv.ts also accepts
# DB1_ and the legacy unprefixed KV_REST_API_* names.
db1_KV_REST_API_URL=https://xxxxx.upstash.io
db1_KV_REST_API_TOKEN=xxxxxxxxxxxxx

# ===========================================
# LocationIQ (REQUIRED) — geocoding, free tier
# ===========================================
LOCATIONIQ_API_KEY=pk.xxxxxxxxxxxxx

# ===========================================
# Vercel Blob (REQUIRED) — nomination photos
# ===========================================
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
